# ============================================================
# SwasthyaSetu AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -----------------------------------------------------------
# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
# Used for: LLM generation (Gemini 1.5 Flash)
# -----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------
# Bhashini API Credentials (Government of India)
# Register free at: https://bhashini.gov.in/ulca/user/register
# Used for: Speech-to-Text (ASR) and Text-to-Speech (TTS)
# If unavailable, set USE_MOCK_BHASHINI=True for demo/testing
# -----------------------------------------------------------
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here

# -----------------------------------------------------------
# Mock/Testing mode (set True to skip real Bhashini API calls)
# Useful for local development and live demos in case of API downtime
# -----------------------------------------------------------
USE_MOCK_BHASHINI=True

# -----------------------------------------------------------
# Application settings
# -----------------------------------------------------------
# Port for the FastAPI server (default: 8000)
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ChromaDB persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./chroma_db

# ChromaDB collection name
CHROMA_COLLECTION_NAME=health_knowledge
